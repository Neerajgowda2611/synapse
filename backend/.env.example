# Server
PORT=8080
APP_ENV=development

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/profiles?sslmode=disable

# Zitadel
ZITADEL_ISSUER=https://idp.xcelerator.work
ZITADEL_API_AUDIENCE=<api-app-client-id>
ZITADEL_WEB_CLIENT_ID=<web-app-client-id>
ZITADEL_REDIRECT_URI=http://localhost:3000/api/auth/callback/zitadel

# Required for username/password login (Session API + IAM_LOGIN_CLIENT role)
ZITADEL_SERVICE_USER_TOKEN=<service-user-pat>
ZITADEL_LOGIN_CLIENT_ID=<service-user-id>

# Frontend (for CORS)
FRONTEND_URL=http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000

# Observation engine background worker (drains stuck received rows)
OBSERVATION_WORKER_ENABLED=true
OBSERVATION_WORKER_INTERVAL=5m
OBSERVATION_WORKER_CONCURRENCY=5

# Derivation engine background worker (recomputes window signals)
DERIVATION_WORKER_ENABLED=true
DERIVATION_WORKER_INTERVAL=5m
DERIVATION_WORKER_CONCURRENCY=5
