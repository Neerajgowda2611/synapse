# Server
PORT=8080
APP_ENV=development

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/profiles?sslmode=disable

# Zitadel (required)
ZITADEL_ISSUER=https://idp.xcelerator.work
ZITADEL_API_AUDIENCE=<api-app-client-id>
ZITADEL_WEB_CLIENT_ID=<web-app-client-id>
# Optional — defaults to $ZITADEL_ISSUER/oauth/v2/keys
# ZITADEL_JWKS_URL=https://idp.xcelerator.work/oauth/v2/keys
ZITADEL_REDIRECT_URI=http://localhost:3000/api/auth/callback/zitadel
ZITADEL_ORG_ID=<zitadel-org-id>

# Required for username/password login (Session API + IAM_LOGIN_CLIENT role)
ZITADEL_SERVICE_USER_TOKEN=<service-user-pat>
ZITADEL_LOGIN_CLIENT_ID=<service-user-id>

# AuthX (optional — when ENABLE_AUTHX=true, AUTH_* vars below are required)
ENABLE_AUTHX=false
AUTH_IDP_URL=https://authx-demo.xceleratordemo.in
AUTHX_CLIENT_ID=<authx-client-id>
AUTHX_CLIENT_SECRET=<authx-client-secret>

# Frontend (for CORS)
FRONTEND_URL=http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001

# Cross-app integrations
XINT_ENABLED=true
XINT_SERVICE_TOKEN=<shared-service-secret>
XINT_ALLOWED_SOURCES=placement,projex,shipx
XINT_PLACEMENT_URL=https://placement.example.com
XINT_PROJEX_URL=https://projex.example.com
XINT_SHIPX_URL=https://mentorship.example.com

# Signed project-fit profile links (falls back to XINT_SERVICE_TOKEN when omitted)
PROFILE_LINK_SIGNING_SECRET=<dedicated-random-secret>
PROFILE_LINK_TTL=1h

# Observation engine background worker (drains stuck received rows)
OBSERVATION_WORKER_ENABLED=true
OBSERVATION_WORKER_INTERVAL=5m
OBSERVATION_WORKER_CONCURRENCY=5

# Derivation engine background worker (recomputes window signals)
DERIVATION_WORKER_ENABLED=true
DERIVATION_WORKER_INTERVAL=5m
DERIVATION_WORKER_CONCURRENCY=5
