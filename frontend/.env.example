# Backend API (browser-visible)
NEXT_PUBLIC_API_URL=http://localhost:8080

# App URL — used to build AuthX OAuth redirect_uri (/auth/callback)
# APP_URL is runtime (server); NEXT_PUBLIC_APP_URL is inlined at build time
NEXT_PUBLIC_APP_URL=http://localhost:3000
# APP_URL=http://localhost:3000

# AuthX (optional — set both flags/vars when enabling AuthX login)
NEXT_PUBLIC_ENABLE_AUTHX=false
# Runtime override for containers built without NEXT_PUBLIC_ENABLE_AUTHX=true
# ENABLE_AUTHX=false

# Browser-visible AuthX OIDC (authorize redirect)
NEXT_PUBLIC_AUTH_IDP_URL=https://authx-demo.xceleratordemo.in
NEXT_PUBLIC_AUTHX_CLIENT_ID=<authx-client-id>

# Server-only BFF secrets (Next.js route handlers — never expose to the browser)
AUTH_IDP_URL=https://authx-demo.xceleratordemo.in
AUTHX_CLIENT_ID=<authx-client-id>
AUTHX_CLIENT_SECRET=<authx-client-secret>
